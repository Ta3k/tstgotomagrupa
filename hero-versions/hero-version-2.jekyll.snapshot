<!-- begin hero: version 2 snapshot -->
{% assign c = "c-hero" %}
<section class="{{c}} animate">
  <div class="container">
    <div class="row">
      <div class="col col-12">
        <div class="{{c}}__inner">

          <div class="{{c}}__left">
            <h1 class="{{c}}__title">{{ include.title }}</h1>
            <div class="{{c}}__description">{{ include.description_html }}</div>
            <div class="{{c}}__btn">
              <a class="works-button c-button c-button--secondary c-button--small" href="{{ include.works_button_link }}">
                {{ include.works_button }}
              </a>
            </div>
          </div>

          <div class="{{c}}__right" aria-hidden="true">
            <div class="{{c}}__visual">
              <div class="{{c}}__aura"></div>

              <svg class="{{c}}__art" viewBox="0 0 620 620" role="presentation" focusable="false">
                <defs>
                  <linearGradient id="hero-gold" x1="90" y1="520" x2="530" y2="100" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="#8b5a16" />
                    <stop offset="0.5" stop-color="#d6a84f" />
                    <stop offset="1" stop-color="#fff0a8" />
                  </linearGradient>
                  <linearGradient id="hero-gold-muted" x1="120" y1="500" x2="500" y2="120" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#6f4818" stop-opacity="0" />
                    <stop offset="0.52" stop-color="#c9943b" stop-opacity="0.72" />
                    <stop offset="1" stop-color="#f8dfa0" stop-opacity="0" />
                  </linearGradient>
                  <radialGradient id="hero-core" cx="50%" cy="42%" r="62%">
                    <stop stop-color="#f4d77f" stop-opacity="0.2" />
                    <stop offset="0.55" stop-color="#9a641e" stop-opacity="0.08" />
                    <stop offset="1" stop-color="#000" stop-opacity="0" />
                  </radialGradient>
                  <radialGradient id="hero-node-glow">
                    <stop offset="0" stop-color="#fff4bf" />
                    <stop offset="0.22" stop-color="#f5d47d" stop-opacity="0.96" />
                    <stop offset="0.48" stop-color="#d49a3e" stop-opacity="0.34" />
                    <stop offset="1" stop-color="#a66a1d" stop-opacity="0" />
                  </radialGradient>
                  <filter id="hero-soft-glow" x="-60%" y="-60%" width="220%" height="220%">
                    <feGaussianBlur stdDeviation="7" result="blur" />
                    <feMerge>
                      <feMergeNode in="blur" />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                </defs>

                <g class="{{c}}__waves">
                  <path d="M38 390 C132 330 205 448 300 388 S468 323 584 380" />
                  <path d="M20 424 C126 352 218 486 320 416 S492 354 606 406" />
                  <path d="M48 458 C151 397 226 508 340 447 S505 397 582 429" />
                </g>

                <g class="{{c}}__atom">
                  <g class="{{c}}__atom-plane {{c}}__atom-plane--one">
                    <ellipse class="{{c}}__atom-path" cx="310" cy="310" rx="244" ry="104" pathLength="100" />
                    <circle class="{{c}}__electron" r="14">
                      <animateMotion dur="9s" repeatCount="indefinite"
                        path="M66 310 A244 104 0 1 0 554 310 A244 104 0 1 0 66 310" />
                    </circle>
                    <circle class="{{c}}__electron {{c}}__electron--small" r="10">
                      <animateMotion dur="12s" begin="-7s" repeatCount="indefinite"
                        path="M554 310 A244 104 0 1 1 66 310 A244 104 0 1 1 554 310" />
                    </circle>
                    <circle class="{{c}}__electron {{c}}__electron--faint" r="9">
                      <animateMotion dur="15s" begin="-3s" repeatCount="indefinite"
                        path="M66 310 A244 104 0 1 0 554 310 A244 104 0 1 0 66 310" />
                    </circle>
                  </g>

                  <g class="{{c}}__atom-plane {{c}}__atom-plane--two" transform="rotate(60 310 310)">
                    <ellipse class="{{c}}__atom-path" cx="310" cy="310" rx="244" ry="104" pathLength="100" />
                    <circle class="{{c}}__electron" r="13">
                      <animateMotion dur="11s" begin="-4s" repeatCount="indefinite"
                        path="M66 310 A244 104 0 1 0 554 310 A244 104 0 1 0 66 310" />
                    </circle>
                    <circle class="{{c}}__electron {{c}}__electron--small" r="10">
                      <animateMotion dur="14s" begin="-10s" repeatCount="indefinite"
                        path="M554 310 A244 104 0 1 1 66 310 A244 104 0 1 1 554 310" />
                    </circle>
                  </g>

                  <g class="{{c}}__atom-plane {{c}}__atom-plane--three" transform="rotate(-60 310 310)">
                    <ellipse class="{{c}}__atom-path" cx="310" cy="310" rx="244" ry="104" pathLength="100" />
                    <circle class="{{c}}__electron" r="12">
                      <animateMotion dur="13s" begin="-8s" repeatCount="indefinite"
                        path="M554 310 A244 104 0 1 1 66 310 A244 104 0 1 1 554 310" />
                    </circle>
                    <circle class="{{c}}__electron {{c}}__electron--small" r="10">
                      <animateMotion dur="10s" begin="-2s" repeatCount="indefinite"
                        path="M66 310 A244 104 0 1 0 554 310 A244 104 0 1 0 66 310" />
                    </circle>
                  </g>
                </g>

                <circle class="{{c}}__core-field" cx="310" cy="310" r="132" />
                <circle class="{{c}}__core-ring" cx="310" cy="310" r="91" />
              </svg>

              <div class="{{c}}__core">
                <strong>360°</strong>
                <span>IT ecosystem</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
<!-- end hero -->
