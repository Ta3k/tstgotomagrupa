/* Hero */
.c-hero {
	$c: &;
	position: relative;
	overflow: hidden;
	padding: clamp(92px, 12vw, 170px) 0;
	background: #000;
	isolation: isolate;

	&::before,
	&::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	&::before {
		background:
			radial-gradient(circle at 74% 52%, rgba(192, 129, 37, .1), transparent 32%),
			radial-gradient(circle at 46% 58%, rgba(137, 86, 20, .07), transparent 27%);
	}

	&::after {
		background: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, .94) 25%, rgba(0, 0, 0, .48) 49%, rgba(0, 0, 0, .06) 72%, rgba(0, 0, 0, .28) 100%);
	}

	&__background {
		position: absolute;
		inset: 0;
		z-index: -2;
		overflow: hidden;
		pointer-events: none;
	}

	&__wave-art {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 112%;
		height: 112%;
		min-width: 1180px;
		transform: translate(-50%, -50%);
	}

	&__haze {
		fill: rgba(191, 125, 31, .12);
		filter: url(#hero-ribbon-blur);
		transform-box: fill-box;
		transform-origin: center;
		animation: hero-haze-breathe 12s ease-in-out infinite;
	}

	&__ribbons {
		transform-box: fill-box;
		transform-origin: center;
	}

	&__ribbon {
		filter: url(#hero-ribbon-blur);
		transform-box: fill-box;
		transform-origin: center;

		&--back {
			fill: url(#hero-ribbon-back);
			opacity: .68;
			animation: hero-ribbon-back-morph 12s ease-in-out infinite;
		}

		&--main {
			fill: url(#hero-ribbon-main);
			opacity: .82;
			animation: hero-ribbon-main-morph 9s ease-in-out infinite;
		}

		&--front {
			fill: url(#hero-ribbon-front);
			opacity: .7;
			animation: hero-ribbon-front-morph 10.5s ease-in-out infinite;
		}
	}

	&__wave-lines {
		fill: none;
		stroke: url(#hero-line-gold);
		stroke-linecap: round;
		transform-box: fill-box;
		transform-origin: center;

		path {
			stroke-width: 1.25;
			opacity: .82;
			animation: hero-line-one-morph 9s ease-in-out infinite;
		}

		path:nth-child(2) {
			stroke-width: .8;
			opacity: .54;
			animation-name: hero-line-two-morph;
			animation-duration: 10.5s;
		}

		path:nth-child(3) {
			stroke-width: .65;
			opacity: .38;
			animation-name: hero-line-three-morph;
			animation-duration: 12s;
		}
	}

	&__particles {
		fill: url(#hero-particle-gold);
		opacity: .78;
		transform-box: fill-box;
		transform-origin: center;
		animation: hero-particles-float 7s ease-in-out infinite alternate;
	}

	&__inner {
		display: flex;
		align-items: center;
		min-height: min(570px, calc(100vh - 190px));
	}

	&__left {
		position: relative;
		z-index: 1;
		width: min(55%, 650px);
	}

	&__title {
		max-width: 680px;
		margin-bottom: 26px;
		color: $heading-font-color;
		font-size: clamp(42px, 4.6vw, 68px);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -.045em;

		strong {
			color: #f6dc91;
			font-weight: inherit;
			text-shadow: 0 0 34px rgba(218, 164, 73, .16);
		}
	}

	&__description {
		max-width: 580px;

		p {
			margin-bottom: 8px;
			color: #a5a5a5;
			font-size: 18px;
			line-height: 1.65;
		}
	}

	&__btn {
		display: flex;
		align-items: center;
		margin-top: 40px;

		.cta-button {
			margin-right: 8px;
		}

		.works-button {
			&:hover .circle-bg {
				transform: scale(.94);
			}

			.circle-bg {
				display: flex;
				align-items: center;
				justify-content: center;
				min-width: 18px;
				height: 18px;
				margin-right: 8px;
				border-radius: 50%;
				background: linear-gradient(90deg, $primary-color 0%, $secondary-color 167%);
				font-size: 14px;
				transition: transform .2s cubic-bezier(.215, .61, .355, 1);
				will-change: transform;
			}

			.button-arrow {
				color: $white;
			}
		}
	}

	@media only screen and (max-width: 1130px) {
		&__title {
			font-size: clamp(40px, 5vw, 56px);
		}
	}

	@media only screen and (max-width: $desktop) {
		padding: 80px 0 96px;

		&__left {
			width: min(62%, 620px);
		}

		&__description p {
			font-size: 16px;
		}

		&__btn {
			margin-top: 32px;
		}
	}

	@media only screen and (max-width: $tablet) {
		padding: 64px 0 90px;

		&::after {
			background: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, .92) 48%, rgba(0, 0, 0, .34) 100%);
		}

		&__wave-art {
			left: 60%;
			width: 150%;
			opacity: .78;
		}

		&__inner {
			min-height: 520px;
		}

		&__left {
			width: min(78%, 650px);
		}
	}

	@media only screen and (max-width: $mobile) {
		padding: 36px 0 68px;

		&::after {
			background: linear-gradient(180deg, rgba(0, 0, 0, .98) 0%, rgba(0, 0, 0, .87) 49%, rgba(0, 0, 0, .32) 100%);
		}

		&__wave-art {
			top: 61%;
			left: 64%;
			width: 220%;
			height: 100%;
			opacity: .66;
		}

		&__inner {
			align-items: flex-start;
			min-height: 570px;
		}

		&__left {
			width: 100%;
		}

		&__title {
			margin-bottom: 22px;
			font-size: 38px;
		}

		&__btn {
			margin-top: 28px;

			.cta-button,
			.works-button {
				font-size: 15px;
			}
		}
	}
}

@keyframes hero-ribbon-back-morph {
	0%,
	100% {
		d: path("M-130 426 C120 297 283 512 495 390 C666 292 800 273 956 385 C1116 500 1300 270 1730 345 L1730 478 C1397 390 1190 594 969 462 C758 337 665 500 475 516 C262 534 88 401 -130 543 Z");
	}

	50% {
		d: path("M-130 458 C110 370 286 286 490 421 C650 527 808 495 960 360 C1122 216 1326 438 1730 324 L1730 468 C1420 560 1215 340 970 492 C760 624 658 405 470 438 C250 477 70 570 -130 520 Z");
	}
}

@keyframes hero-ribbon-main-morph {
	0%,
	100% {
		d: path("M-130 492 C123 422 264 325 447 440 C625 552 762 553 932 399 C1100 248 1193 335 1320 416 C1448 498 1568 390 1730 306 L1730 451 C1510 578 1395 551 1244 454 C1089 356 1036 441 921 525 C748 652 558 560 402 483 C235 400 78 562 -130 594 Z");
	}

	50% {
		d: path("M-130 520 C118 600 270 470 445 365 C620 260 760 350 930 485 C1104 624 1194 500 1322 380 C1452 258 1570 340 1730 425 L1730 548 C1512 410 1400 365 1245 500 C1090 636 1030 540 920 455 C750 325 560 420 400 520 C230 625 75 450 -130 570 Z");
	}
}

@keyframes hero-ribbon-front-morph {
	0%,
	100% {
		d: path("M-130 532 C98 430 221 463 369 526 C546 602 698 610 845 490 C1008 357 1126 360 1254 455 C1399 563 1536 518 1730 413 L1730 529 C1514 650 1351 645 1196 535 C1078 451 1013 488 864 589 C690 707 495 663 345 590 C182 512 42 606 -130 662 Z");
	}

	50% {
		d: path("M-130 562 C90 650 226 555 374 446 C548 318 694 405 842 548 C1005 706 1124 585 1250 486 C1396 370 1532 410 1730 502 L1730 614 C1510 520 1350 484 1192 606 C1075 696 1010 614 860 512 C686 394 490 485 340 628 C178 780 38 550 -130 602 Z");
	}
}

@keyframes hero-line-one-morph {
	0%,
	100% {
		d: path("M-80 467 C131 355 286 381 441 461 C616 552 752 545 922 405 C1090 267 1193 345 1318 425 C1457 514 1570 412 1680 351");
	}

	50% {
		d: path("M-80 486 C128 592 288 538 444 405 C612 262 756 350 924 490 C1094 632 1190 504 1320 382 C1458 252 1572 340 1680 438");
	}
}

@keyframes hero-line-two-morph {
	0%,
	100% {
		d: path("M-70 527 C127 434 244 453 379 516 C552 596 696 596 847 486 C1011 367 1119 370 1255 460 C1401 557 1535 520 1680 439");
	}

	50% {
		d: path("M-70 548 C124 624 247 548 382 450 C550 328 694 400 850 555 C1008 712 1120 584 1258 490 C1404 390 1534 410 1680 510");
	}
}

@keyframes hero-line-three-morph {
	0%,
	100% {
		d: path("M-55 411 C152 326 300 508 491 397 C664 296 809 287 956 390 C1114 501 1296 282 1680 348");
	}

	50% {
		d: path("M-55 452 C150 540 302 342 494 446 C660 536 812 492 960 350 C1110 206 1300 470 1680 382");
	}
}

@keyframes hero-particles-float {
	0% {
		transform: translate3d(-7px, 8px, 0);
		opacity: .52;
	}

	100% {
		transform: translate3d(9px, -10px, 0);
		opacity: .9;
	}
}

@keyframes hero-haze-breathe {
	0%,
	100% {
		transform: scale(.96);
		opacity: .68;
	}

	50% {
		transform: scale(1.04);
		opacity: 1;
	}
}

@media (prefers-reduced-motion: reduce) {
	.c-hero__haze,
	.c-hero__ribbon,
	.c-hero__wave-lines path,
	.c-hero__particles {
		animation: none;
	}
}

